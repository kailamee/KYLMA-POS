<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="Mangubat"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Mangubat;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="BusinessName" value="Enterprise POS" />
    <add key="BusinessAddress" value="Your store address" />
    <add key="BusinessPhone" value="Your phone number" />
    <add key="ReturnPolicy" value="Items may be returned within 7 days with this receipt." />
    <add key="TaxRatePercent" value="12" />
  </appSettings>
</configuration>
